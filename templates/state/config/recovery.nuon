{
  schema: 1
  default_profiles: [personal]
  state_dir: "~/.local/state/reseed"
  git: {
    branch: main
    remote: origin
  }
  setup: {
    ssh: {
      # SSH key comment; defaults to the Git identity email.
      comment: ""
      # Hosts receiving the public key during "reseed setup ssh-remote".
      # admin also appends the key to the admin allow list on the host.
      # hosts: [
      #   {user: "alice" host: "example.com" port: 22 admin: false os: "unix"}
      # ]
      hosts: []
    }
    gpg: {
      key_type: ed25519
    }
  }
  chezmoi: {
    enabled: true
    apply_args: []
  }
  software: {
    winget: {
      enabled: true
      manifests: [packages/windows/winget.json]
      export_on_backup: false
      update: true
    }
    homebrew: {
      enabled: true
      manifests: [packages/macos/Brewfile]
      export_on_backup: false
      update: true
      # Optional per-command environment for brew, e.g. a China mirror.
      # To enable, uncomment and pick a mirror:
      # env: {
      #   "HOMEBREW_API_DOMAIN": "https://mirrors.ustc.edu.cn/homebrew-bottles/api"
      #   "HOMEBREW_BOTTLE_DOMAIN": "https://mirrors.ustc.edu.cn/homebrew-bottles"
      #   "HOMEBREW_BREW_GIT_REMOTE": "https://mirrors.ustc.edu.cn/brew.git"
      #   "HOMEBREW_CORE_GIT_REMOTE": "https://mirrors.ustc.edu.cn/homebrew-core.git"
      #   "HOMEBREW_CASK_GIT_REMOTE": "https://mirrors.ustc.edu.cn/homebrew-cask.git"
      # }
    }
    mise: {
      enabled: true
      configs: [mise.toml]
      manager_config: mise.toml
      task_files: [scripts/configure-shells.nu]
      cargo_binstall: {
        enabled: false
        manifests: [packages/cargo/binstall.nuon]
        update: true
      }
      uv: {
        enabled: true
        manifests: [packages/uv/tools.nuon]
        update: true
      }
      pnpm: {
        enabled: true
        manifests: [packages/node/pnpm/global.nuon]
        update: true
      }
      yarn: {
        enabled: false
        manifests: [packages/node/yarn/global.nuon]
        update: true
      }
      bun: {
        enabled: false
        manifests: [packages/node/bun/global.nuon]
        update: true
      }
      update: true
      restore_tasks: [reseed:shells]
    }
    finder_services: {
      # macOS Finder context menu (Quick Actions): "Open Terminal Here" opens
      # the frontmost Finder window's folder in a terminal, and two "Open in
      # VS Code" entries act on exclusive contexts — the frontmost window's
      # folder and the right-clicked selection.
      enabled: true
    }
  }
  kopia: {
    enabled: false
    snapshot_paths: []
    restore: []
  }
  observations: {
    tool_managers: [cargo pnpm bun uv npm yarn]
  }
  bundle: {
    paths: []
    include_tools: [git chezmoi nu mise]
  }
}
